.env
.env.local
.env.*.local
*.pem
*.key

# Thư viện — mỗi máy tự cài bằng "npm install"
node_modules/
.pnp
.pnp.js

# Kết quả build
.next/
out/
build/
dist/

# Code Prisma tự sinh — mỗi máy tự tạo bằng "npx prisma generate"
/src/generated/

# Cơ sở dữ liệu để trên máy (nếu có dùng tạm)
*.db
*.db-journal
*.sqlite
*.sqlite3

# File tạm của hệ điều hành
.DS_Store
Thumbs.db
desktop.ini

# Log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/logs/

# Cache công cụ
.eslintcache
.turbo/
coverage/
*.tsbuildinfo

# Cấu hình riêng của trình soạn thảo
.vscode/*
!.vscode/extensions.json
.idea/

# File âm thanh sinh ra (TTS/voice note) — không đưa lên repo
/public/generated/
/storage/

