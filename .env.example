# ==========================================================
# FILE MẪU — chép file này thành ".env" rồi điền giá trị thật
#
#   Windows:  copy .env.example .env
#
# File ".env" đã được .gitignore chặn, KHÔNG bao giờ lên GitHub.
# Mỗi máy (PC nhà / laptop công ty) cần có file .env riêng.
# ==========================================================


# ----- Cơ sở dữ liệu -----
# Postgres có hỗ trợ pgvector. Dùng Neon (miễn phí) để cả hai máy
# cùng trỏ về một database, dữ liệu quét được luôn đồng bộ.
# Lấy tại: https://neon.tech  →  tạo project  →  copy connection string
#
# Neon cho hai dạng địa chỉ:
#   - Có "-pooler": dùng khi ứng dụng chạy (chịu được nhiều kết nối)
#   - Không "-pooler": dùng khi tạo/sửa bảng, vì lệnh tạo bảng cần kết nối
#     trực tiếp. Chỉ cần bỏ chữ "-pooler" khỏi địa chỉ là ra.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"


# ----- Claude (Anthropic) -----
# Dùng để phân loại nội dung, chấm chất lượng, thuật lại bài viết, trò chuyện.
# Lấy tại: https://console.anthropic.com  →  Settings  →  API Keys
ANTHROPIC_API_KEY="sk-ant-..."


# ----- YouTube Data API v3 -----
# Dùng để quét kênh và tìm video. Hạn mức miễn phí 10.000 units/ngày.
# Lấy tại: https://console.cloud.google.com
#   → tạo project → bật "YouTube Data API v3" → Credentials → API key
YOUTUBE_API_KEY="AIza..."


# ----- Đăng nhập Google + quyền quản lý playlist -----
# Dùng để đăng nhập và (khi bật) để AI sắp xếp playlist trên kênh của bạn.
# Cùng trang Google Cloud ở trên → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Chuỗi ngẫu nhiên để mã hoá phiên đăng nhập. Tự sinh bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Email Google duy nhất được phép đăng nhập. App dùng riêng cho một người, ai
# khác bấm đăng nhập cũng bị từ chối. Bỏ trống thì chặn tất cả.
EMAIL_CHU_DU_AN=""


# ----- Embeddings (tìm kiếm theo ngữ nghĩa) -----
# Lấy tại: https://dash.voyageai.com
VOYAGE_API_KEY=""


# ----- Giọng đọc tiếng Việt (TTS) -----
# Dùng để đọc bản thuật lại bài blog và bản tin audio hằng ngày.
# Điền sau, khi triển khai Phase 2.
TTS_PROVIDER=""
TTS_API_KEY=""


# ----- Nhận dạng giọng nói (ghi chú bằng lời) -----
# Điền sau, khi triển khai phần ghi chú.
ASR_API_KEY=""


# ----- Cổng API trợ lý (/api/v1/tro-ly/*) -----
# Token để app điện thoại và curl gọi được vào API. Mỗi thiết bị MỘT token,
# cách nhau dấu phẩy — lộ cái nào thì xoá cái đó khỏi đây là xong, không ảnh
# hưởng thiết bị khác.
#
# Tự sinh một token mới bằng:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# Ví dụ hai thiết bị:
#   TOKEN_TRO_LY="token_dien_thoai,token_may_tinh"
TOKEN_TRO_LY=""


# ----- Cài đặt vận hành -----
# Giờ quét tự động hằng ngày (giờ Việt Nam)
DAILY_SCAN_HOUR="21"
TZ="Asia/Ho_Chi_Minh"

# Ngân sách quota YouTube mỗi ngày — chạm 80% thì tự ngắt phần tìm kiếm mở rộng
YOUTUBE_DAILY_QUOTA="10000"


# ----- Cách gọi Claude -----
# "cli"  = dùng Claude Code CLI đã cài trên máy (gói Claude Pro/Max trả theo
#          tháng — KHÔNG tính tiền theo chữ). Cần đăng nhập một lần: gõ `claude`
#          trong terminal. Đây là mặc định khi máy có sẵn CLI.
# "api"  = dùng ANTHROPIC_API_KEY ở trên (tính tiền theo chữ).
# Bỏ trống thì tự chọn: có CLI thì dùng CLI, không thì dùng khoá API.
CACH_GOI_CLAUDE=""

# Đường dẫn tới Claude CLI, chỉ cần khai khi máy cài ở chỗ lạ
CLAUDE_CLI_PATH=""

# Chờ tối đa một lần gọi CLI, tính bằng mili giây (mặc định 180000 = 3 phút)
CLAUDE_CLI_TIMEOUT_MS=""

# Model dùng để phân loại. Bỏ trống thì tự chọn theo đường gọi:
#   qua CLI → claude-sonnet-5 (không tốn thêm tiền nên dùng model mạnh)
#   qua API → claude-haiku-4-5 (rẻ hơn ba lần)
MODEL_PHAN_LOAI=""

# Khoá cho dịch vụ hẹn giờ gọi vào tuyến /api/cron/quet-dem khi triển khai lên
# máy chủ. Chạy trên máy cá nhân thì không cần — dùng Task Scheduler gọi thẳng
# scripts/quet-dem.cmd (xem docs/tu-chay-hang-dem.md).
# Sinh bằng: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
KHOA_CRON=""
